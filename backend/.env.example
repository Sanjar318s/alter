JWT_SECRET=change-me-in-production
PORT=4000
NODE_ENV=development

# Email: SMTP or Resend. Required for registration by email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ALTER <noreply@yourdomain.com>"
# RESEND_API_KEY=

# SMS: Eskiz (Uzbekistan) or Twilio. Required for registration by phone.
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=4546
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Dev: without SMTP/SMS, OTP is written to backend/data/outbox/ (default in development).
# OTP_DEV_OUTBOX=0
# Dev: return OTP in API responses (default in development). Set OTP_ECHO=0 to disable.
# OTP_ECHO=1

# GIF search in chat (Giphy). Without key, a small demo set is used.
# GIPHY_API_KEY=

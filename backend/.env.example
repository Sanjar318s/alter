# Platform owner account (staffRole=owner). Set before: npm run owner:register
# OWNER_USERNAME=nyx.cosplay
# OWNER_PHONE=+998...
# OWNER_PASSWORD=

PORT=4000
NODE_ENV=development

# Email: SMTP or Resend. Required for registration by email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ALTER <noreply@yourdomain.com>"
# RESEND_API_KEY=

# SMS: Eskiz (Uzbekistan) or Twilio. Required for registration by phone.
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=4546
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Dev: without SMTP/SMS, OTP is written to backend/data/outbox/ (default in development).
# OTP_DEV_OUTBOX=0
# Dev: return OTP in API responses (default in development). Set OTP_ECHO=0 to disable.
# OTP_ECHO=1

# GIF search in chat (Giphy). Without key, a small demo set is used.
# GIPHY_API_KEY=

# ─── YouTube auto-publish (brand Shorts) ───────────────────────
# Google Cloud OAuth 2.0 (Web). Enable YouTube Data API v3.
# Redirect URI (exact): https://<api-host>/api/admin/social/youtube/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://alter-api-young-lantern-9418.fly.dev/api/admin/social/youtube/callback
# GEMINI_API_KEY=          # content moderation before publish (required for auto-flow)
# GEMINI_MODEL=gemini-2.0-flash
# YOUTUBE_DAILY_UPLOAD_CAP=5
# SOCIAL_PUBLISH_PLATFORMS=youtube   # comma list: youtube,tiktok,instagram,facebook
# SOCIAL_POLL_MS=15000               # social worker poll interval
# PUBLIC_API_URL=https://alter-api-young-lantern-9418.fly.dev
# PUBLIC_SITE_URL=https://altercosplay.vercel.app

# Meta / TikTok (not enabled in UI yet — configure when ready)
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_OAUTH_REDIRECT_URI=

# Turso (production SQLite). Use a database-scoped token, not an account token.
# TURSO_DATABASE_URL=libsql://alter-org.turso.io
# TURSO_AUTH_TOKEN=

# Cloudflare R2 (production file storage). Without these, files use backend/uploads/ locally.
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=alter-uploads
# Optional: public bucket URL (r2.dev or custom domain). If unset, files are served via /uploads proxy.
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Telegram userbot (GramJS) → sync to ch-events
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=+998...
# TELEGRAM_SOURCE_CHAT=cosplayers_uzb
# TELEGRAM_TOPIC_ID=60704
# TELEGRAM_AFISHA_CHAT=afishauz
# TELEGRAM_AFISHA_KEYWORDS=косплей,comic con,geek con,аниме фест
# TELEGRAM_SESSION=  # or data/telegram.session after npm run telegram:auth
# Poll: npm run telegram:poll (hourly on Fly process group `telegram`)
# TELEGRAM_PUBLISH_PREFIX=📣 Cosplayers UZ
# TELEGRAM_PUBLISH_USERNAME=alter.events
# TELEGRAM_PUBLISH_USER_ID=
# TELEGRAM_SYNC_SECRET=
